# The domain players will use. Point its DNS A (and AAAA) record at this server
# first. For a trial on your own machine, use: DOMAIN=localhost
DOMAIN=play.example.com

# The first admin account, created on first start. Use a long password.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# How many nightly backups to keep (in the data volume, under /data/backups).
BACKUP_KEEP=14
